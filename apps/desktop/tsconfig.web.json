{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "../..",
    "outDir": "../../.tsbuild/web",
    "baseUrl": ".",
    "paths": {
      "@bridge/*": ["../../packages/*/src/index.ts"], "@shared/*": ["src/shared/*"] }
  },
  "include": ["src/policy/matcher.ts", "src/scanners/secrets.ts", "src/scanners/injection.ts", "src/scanners/redaction.ts", "../../packages/catalogue-data/src/**/*", "../../packages/favicon/src/**/*", "../../packages/types/src/**/*", "../../packages/registry/src/**/*", "src/renderer/**/*", "src/shared/**/*"]
}
